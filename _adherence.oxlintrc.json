{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "site/**",
              "ui_kits/style-guide/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: title, items, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|context|trend|accent|key|ref|className|style|children)$/]",
        "message": "<BigNumber> doesn't accept that prop. Declared props: label, value, context, trend, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumber'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<BigNumber> trend must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumber'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:brand|accent)$/]",
        "message": "<BigNumber> accent must be one of 'brand' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|busy|type|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, busy, type, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: kind, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:rule|avoid|adapt|why)$/]",
        "message": "<Callout> kind must be one of 'rule' | 'avoid' | 'adapt' | 'why'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|count|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: pressed, count, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|as|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: mark, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|span|div)$/]",
        "message": "<Eyebrow> as must be one of 'p' | 'span' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|description|href|tags|key|ref|className|style|children)$/]",
        "message": "<PostListItem> doesn't accept that prop. Declared props: title, date, description, href, tags."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|year|summary|tags|showTags|image|href|dense|onClick|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: title, year, summary, tags, showTags, image, href, dense, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|href|key|ref|className|style|children)$/]",
        "message": "<ProjectNote> doesn't accept that prop. Declared props: title, summary, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='RulePair'] > JSXAttribute > JSXIdentifier[name!=/^(?:doItems|avoidItems|key|ref|className|style|children)$/]",
        "message": "<RulePair> doesn't accept that prop. Declared props: doItems, avoidItems."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|moreLabel|moreHref|onMore|level|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: title, moreLabel, moreHref, onMore, level."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hex|ink|height|onCopy|key|ref|className|style|children)$/]",
        "message": "<Swatch> doesn't accept that prop. Declared props: name, hex, ink, height, onCopy."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|strong|plain)$/]",
        "message": "<Tag> tone must be one of 'default' | 'strong' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|onToggle|showLabel|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: theme, onToggle, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ThemeToggle> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tide'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|code|key|ref|className|style|children)$/]",
        "message": "<Tide> doesn't accept that prop. Declared props: label, code."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
